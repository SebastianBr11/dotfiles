#!/usr/bin/env bash

export DEV_FOLDER="$HOME/dev"

cd "$DEV_FOLDER" || exit 1

# deterministic hue 0..359
tag_hue() {
  local tag="$1"
  local hex
  hex=$(printf '%s' "$tag" | md5sum | awk '{print $1}')
  echo $(((16#${hex:0:3}) % 360))
}

# HSV(h, s, v) -> RGB
# h: 0..360, s/v: 0..1
hsv_to_rgb() {
  local H="$1" S="$2" V="$3"
  awk -v H="$H" -v S="$S" -v V="$V" '
  BEGIN{
    H = H % 360; if (H<0) H += 360
    C = V*S
    t = H/60
    X = C*(1 - sqrt( ((t%2)-1)*((t%2)-1) ))   # abs(t%2 - 1) without abs()

    m = V-C
    if (H<60)       {r=C; g=X; b=0}
    else if (H<120){r=X; g=C; b=0}
    else if (H<180){r=0; g=C; b=X}
    else if (H<240){r=0; g=X; b=C}
    else if (H<300){r=X; g=0; b=C}
    else            {r=C; g=0; b=X}

    # clamp helper
    if (r<0) r=0; if (r>1) r=1
    if (g<0) g=0; if (g>1) g=1
    if (b<0) b=0; if (b>1) b=1

    r = r + m; g = g + m; b = b + m
    printf "%d,%d,%d\n", int(r*255+0.5), int(g*255+0.5), int(b*255+0.5)
  }'
}

main_language() {
  local dir="$1" file ext
  declare -A counts=()

  while IFS= read -r -d '' file; do
    ext="${file##*.}"
    ext="${ext,,}"
    case "$ext" in
    js | mjs | cjs | jsx) counts[javascript]=$((${counts[javascript]:-0} + 1)) ;;
    ts | mts | cts | tsx) counts[typescript]=$((${counts[typescript]:-0} + 1)) ;;
    rs) counts[rust]=$((${counts[rust]:-0} + 1)) ;;
    py | pyw) counts[python]=$((${counts[python]:-0} + 1)) ;;
    java) counts[java]=$((${counts[java]:-0} + 1)) ;;
    c | h) counts[c]=$((${counts[c]:-0} + 1)) ;;
    adb | ads) counts[ada]=$((${counts[ada]:-0} + 1)) ;;
    pl | pro) counts[prolog]=$((${counts[prolog]:-0} + 1)) ;;
    lisp | lsp | cl | el) counts[lisp]=$((${counts[lisp]:-0} + 1)) ;;
    typ) counts[typst]=$((${counts[typst]:-0} + 1)) ;;
    tex | latex) counts[latex]=$((${counts[latex]:-0} + 1)) ;;
    sh | bash) counts[bash]=$((${counts[bash]:-0} + 1)) ;;
    esac
  done < <(
    find "$dir" \
      \( -name .git -o -name node_modules -o -name vendor -o -name target \) -prune \
      -o -type f -print0
  )

  local best= max=0 count
  for ext in javascript typescript rust python java c ada prolog lisp typst latex bash; do
    count=${counts[$ext]:-0}
    if ((count > max)); then
      max=$count
      best="$ext"
    fi
  done

  local color="32"
  local icon=""
  case "$best" in
  javascript)
    icon=''
    color='36'
    ;;
  typescript)
    icon=''
    color='34'
    ;;
  rust)
    icon='󱘗'
    color='31'
    ;;
  python)
    icon=''
    color='33'
    ;;
  java)
    icon=''
    color='31'
    ;;
  c)
    icon=''
    color='34'
    ;;
  ada)
    icon=''
    color='35'
    ;;
  prolog)
    icon=''
    color='32'
    ;;
  lisp)
    icon=''
    color='35'
    ;;
  typst)
    icon=''
    color='36'
    ;;
  latex)
    icon=''
    color='34'
    ;;
  bash)
    icon=''
    color='32'
    ;;
  esac

  printf '\033[%sm%s\033[0m\t%s' "$color" "$icon"
}

check_dir() {
  # parent_dirs is shown kind of like a tag
  local dir repo_found parent_dirs
  for dir in */; do
    repo_found=0

    # path from $DEV_FOLDER to the current dir we're about to descend into
    parent_dirs="${PWD#"$DEV_FOLDER"}"
    parent_dirs="${parent_dirs#/}"
    parent_dirs="${parent_dirs%/}"

    tag="$parent_dirs"
    h=$(tag_hue "$tag")

    rgb="$(hsv_to_rgb "$h" 0.65 0.85)" # "R,G,B"
    r="${rgb%%,*}"
    tmp="${rgb#*,}"
    g="${tmp%%,*}"
    b="${tmp#*,}"

    # detect repo (handles both .git dir and gitdir file for worktrees/submodules)
    if [ -e "$dir/.git" ]; then
      if [ -d "$dir/.git" ] || [ -f "$dir/.git" ]; then
        if (cd "$dir" && git rev-parse --is-inside-work-tree >/dev/null 2>&1); then
          repo_found=1
        fi
      fi
    fi

    cd "$dir" >/dev/null 2>&1 || continue

    if [ "$repo_found" -eq 1 ]; then
      language=$(main_language "$PWD")
      branch=$(git branch --show-current 2>/dev/null || true)
      branchtext=${branch:-detached}
      branchtext="[$branchtext]"
      tagtext=${tag:+("$tag")}

      printf '%s %s \033[90m %s \033[0m\033[38;2;%s;%s;%sm%s\033[0m\t%s\n' \
        "$language" "${dir%/}" "$branchtext" "$r" "$g" "$b" "$tagtext" \
        "${PWD#"$DEV_FOLDER"/}"

      cd .. >/dev/null
      continue # avoid nested repos
    fi

    check_dir
    cd .. >/dev/null
  done
}

folder=$(
  check_dir |
    fzf --ansi \
      --delimiter=$'\t' \
      --with-nth=1 \
      --accept-nth=2 \
      --layout=reverse \
      --height=50% \
      --preview='
          dir="$DEV_FOLDER"/{2}

          # Show contents of README
          readme="$(find "$dir" -maxdepth 1 -type f -iname "*readme*" -print -quit)"
          if [[ -n "$readme" ]]; then
            if command -v bat >/dev/null 2>&1; then
              bat "$readme" --color=always --style=plain --line-range=:500
            else
              cat "$readme"
            fi
          else
            # Show directory contents when no README
            # Prefer eza over ls if available
            if command -v eza >/dev/null 2>&1; then
              eza "$dir" --icons=always -1 --group-directories-first --color=always | head -n 200
            else
              ls -R -1 "$dir" 2>&1 | head -n 200
            fi
          fi
        '
)

if [[ -n "$folder" ]]; then
  echo "$DEV_FOLDER/$folder"
fi
