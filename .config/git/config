	autoSetupRemote = true
	followTags = true
[core]
	editor = nvim
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
[help]
	autocorrect = prompt
[merge]
	conflictstyle = zdiff3
