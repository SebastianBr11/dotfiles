[user]
	name = Sebastian Breit
	email =  41546861+SebastianBr11@users.noreply.github.com
[gpg]
        format = ssh
[rerere]
	enabled = true
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
	followTags = true
[core]
	editor = nvim
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
[help]
	autocorrect = prompt
[merge]
	conflictstyle = zdiff3

[includeIf "gitdir:~/dev/"]
	path = ~/dev/.gitconfig
[includeIf "gitdir:~/dev/uni/"]
	path = ~/dev/uni/.gitconfig
[alias]
	merge-log-short = "!f() { git log --pretty=oneline \"$1^..$1\"; }; f"
