input {
  keyboard {
    repeat-dely 200
    xkb {
      layout "de"
      options: "caps:escape" // Make caps act like escape
    }
  }
}

window-rule {
  match app-id="^foot$"

  background-effect {
    blur true
  }
}

window-rule {
  match app-id="^kitty$"

  background-effect {
    blur true
  }
}
